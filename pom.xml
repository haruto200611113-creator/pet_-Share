<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================== -->
    <!-- プロジェクト基本情報 -->
    <!-- ========================================== -->

    <groupId>com.petshare</groupId>
    <artifactId>pet-share</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- Tomcatへ配置するWARファイル -->
    <packaging>war</packaging>


    <!-- ========================================== -->
    <!-- Java設定 -->
    <!-- ========================================== -->

    <properties>

        <!-- Java 21 -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- UTF-8 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    </properties>


    <!-- ========================================== -->
    <!-- 依存ライブラリ -->
    <!-- ========================================== -->

    <dependencies>


        <!-- ====================================== -->
        <!-- Jakarta Servlet API -->
        <!-- Tomcat 11 / Jakarta Servlet 6.1 -->
        <!-- ====================================== -->

        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>provided</scope>
        </dependency>


        <!-- ====================================== -->
        <!-- MySQL JDBC Driver -->
        <!-- Aiven MySQL接続 -->
        <!-- ====================================== -->

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.5.0</version>
        </dependency>


        <!-- ====================================== -->
        <!-- BCrypt -->
        <!-- パスワードのハッシュ化 -->
        <!-- ====================================== -->

        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>


        <!-- ====================================== -->
        <!-- HikariCP -->
        <!-- DBコネクションプール -->
        <!-- ====================================== -->

        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>7.0.2</version>
        </dependency>


        <!-- ====================================== -->
        <!-- TwelveMonkeys ImageIO -->
        <!-- JPEG画像読み込み対応 -->
        <!-- ====================================== -->

        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-jpeg</artifactId>
            <version>3.12.0</version>
        </dependency>


        <!-- ====================================== -->
        <!-- TwelveMonkeys ImageIO Core -->
        <!-- ====================================== -->

        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-core</artifactId>
            <version>3.12.0</version>
        </dependency>


        <!-- ====================================== -->
        <!-- TwelveMonkeys Servlet -->
        <!-- Jakarta Servlet用 -->
        <!-- ImageIOプラグイン登録 -->
        <!-- ====================================== -->

        <dependency>
            <groupId>com.twelvemonkeys.servlet</groupId>
            <artifactId>servlet</artifactId>
            <version>3.12.0</version>
            <classifier>jakarta</classifier>
        </dependency>


    </dependencies>


    <!-- ========================================== -->
    <!-- ビルド設定 -->
    <!-- ========================================== -->

    <build>

        <!-- 作成されるWARファイル名 -->
        <!-- target/pet_share.war -->
        <finalName>pet_share</finalName>


        <plugins>


            <!-- ====================================== -->
            <!-- Javaコンパイラ -->
            <!-- ====================================== -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>

                <artifactId>maven-compiler-plugin</artifactId>

                <version>3.13.0</version>

                <configuration>

                    <release>21</release>

                </configuration>

            </plugin>


            <!-- ====================================== -->
            <!-- WARファイル作成 -->
            <!-- ====================================== -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>

                <artifactId>maven-war-plugin</artifactId>

                <version>3.4.0</version>

                <configuration>

                    <!-- web.xmlがなくてもWARを作成可能 -->
                    <failOnMissingWebXml>false</failOnMissingWebXml>

                </configuration>

            </plugin>


        </plugins>

    </build>

</project>
